# /docker/flask/Dockerfile-flask
FROM public.ecr.aws/docker/library/python:3.10.20-slim
LABEL authors="philippsteigerwald"

WORKDIR /app

# System-Abhaengigkeiten (klein, aendert sich selten)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gosu \
    libgomp1 \
    default-mysql-client \
    # Playwright dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# Installiert websocat
RUN curl -L https://github.com/vi/websocat/releases/download/v1.8.0/websocat.x86_64-unknown-linux-musl \
    -o /usr/local/bin/websocat && \
    chmod +x /usr/local/bin/websocat

RUN mkdir -p /app/models && \
    mkdir -p /app/storage/rag_images /app/storage/screenshots

# Layer 3a: Schwere ML-Dependencies separat (torch ~2.5GB, transformers, flair)
# Aendert sich sehr selten → eigener cached Layer
COPY app/requirements-heavy.txt /app/requirements-heavy.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /app/requirements-heavy.txt

# Layer 3b: Restliche Python-Dependencies (BuildKit Cache fuer schnelle Updates)
COPY app/requirements.txt /app/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /app/requirements.txt

# Playwright browser install location (shared, not user-home dependent)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Create non-root user BEFORE installing Playwright
RUN groupadd -r flaskuser && useradd -r -g flaskuser -u 1001 -m flaskuser && \
    mkdir -p /ms-playwright

# Pre-create runtime data dirs and chown to flaskuser. The crawler writes
# scraped pages to /app/data/rag/crawls/ at runtime; if the dir doesn't
# exist at image-build-time it gets created on first write with whatever
# uid the gunicorn worker happens to have. A previous image had
# flaskuser=997, the current one is 1001 — the dir kept the old 997
# ownership and silently broke every crawl with EACCES (Errno 13). Pin
# the floor here so any future uid drift can't recreate the bug.
RUN mkdir -p /app/data/rag/crawls /app/data/rag/screenshots && \
    chown -R flaskuser:flaskuser /app/data && \
    chmod 755 /app/data/rag/crawls /app/data/rag/screenshots

# Installiert Playwright Chromium Browser (cached at /ms-playwright)
RUN playwright install chromium && \
    chown -R flaskuser:flaskuser /ms-playwright

# Layer 4: Anwendungscode (aendert sich haeufig)
COPY app /app/
COPY docker/flask/start_flask.sh /usr/local/bin/start_flask.sh
COPY docker/flask/start_llars_worker.sh /usr/local/bin/start_llars_worker.sh
COPY docker/flask/healthcheck.sh /usr/local/bin/healthcheck.sh
COPY docker/flask/gunicorn.conf.py /usr/local/bin/gunicorn.conf.py
RUN chmod +x /usr/local/bin/start_flask.sh && \
    chmod +x /usr/local/bin/start_llars_worker.sh && \
    chmod +x /usr/local/bin/healthcheck.sh

ENV FLASK_APP=main

# Set permissions (includes /app/storage for Docker volume mounts)
RUN chown -R flaskuser:flaskuser /app && \
    chown -R flaskuser:flaskuser /app/models && \
    chown -R flaskuser:flaskuser /app/storage

CMD ["/usr/local/bin/start_flask.sh"]
