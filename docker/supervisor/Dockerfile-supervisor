# syntax=docker/dockerfile:1
FROM public.ecr.aws/docker/library/python:3.10-slim
RUN apt-get -y update && apt-get -y install --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /supervisor

# Layer 1: Dependencies (cached)
COPY /docker/supervisor/supervisor_requirements.txt /supervisor/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /supervisor/supervisor_requirements.txt

# Layer 2: Application code
COPY /supervisor/ /supervisor/
COPY /docker/supervisor/start_supervisor.sh /supervisor/
