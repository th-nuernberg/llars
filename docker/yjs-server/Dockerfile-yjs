# 1. Offizielles Node-Image als Grundlage:
FROM public.ecr.aws/docker/library/node:23-slim
LABEL authors="philippsteigerwald"

WORKDIR /yjs-server
RUN mkdir /scripts
COPY docker/yjs-server/start_yjs.sh /scripts/
RUN chmod +x /scripts/start_yjs.sh

# 2. Dependencies (cached solange package*.json sich nicht aendert)
# BuildKit cache mount haelt npm-Cache zwischen Builds persistent
COPY yjs-server/package.json yjs-server/package-lock.json /yjs-server/
RUN npm ci && \
    touch node_modules/.install-stamp

# 3. Restlichen Source code kopieren
COPY yjs-server /yjs-server/

# 4. Create non-root user and set permissions
RUN groupadd -r yjsuser && useradd -r -g yjsuser -u 1002 -m yjsuser && \
    chown -R yjsuser:yjsuser /yjs-server && \
    chown -R yjsuser:yjsuser /scripts

USER yjsuser

CMD ["/bin/bash", "/scripts/start_yjs.sh"]
